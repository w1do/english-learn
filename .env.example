MINIO=
PUBLIC_DIRECTUS_URL=

# Server-only Directus access for payment callbacks.
DIRECTUS_URL=
DIRECTUS_SERVICE_TOKEN=

# Server-only Platega credentials. Never use PUBLIC_ for these values.
PLATEGA_BASE_URL=https://app.platega.io
PLATEGA_MERCHANT_ID=replace-with-merchant-id
PLATEGA_SECRET=replace-with-api-secret
PLATEGA_RETURN_URL=https://domain.ru/payment/result
PLATEGA_FAILED_URL=https://domain.ru/payment/failed
