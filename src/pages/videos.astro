---
import { videoLevels } from '../lib/videos-mock';
import PageLayout from '../layouts/PageLayout.astro';
---
<PageLayout title="Видеоуроки по английскому - тренировка перевода по уровням" description="Короткие видео-карточки для тренировки перевода с русского на английский. Уровни от A1 до B2 - выбирайте свой уровень и занимайтесь в удобном темпе." activePage="videos">
    <style is:inline>
        .video-locked .thumb {
            position: relative;
            cursor: pointer;
        }
        .video-locked .lock-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            z-index: 2;
        }
        .video-locked .lock-overlay img {
            width: 48px;
            height: 48px;
        }
    </style>
    <main class="page-videos">
        <section>
            <div class="container">
                <h1 class="page-title">Видеоуроки по уровням</h1>
                <p class="page-subtitle">Выбирайте уровень и тренируйте перевод по коротким видео-карточкам</p>
                <div class="levels" id="levels-list">
                    {videoLevels.map((level, i) => (
                        <div class={`item${i === 0 ? ' active' : ''}`} data-level-id={level.id}>
                            <div class="title">{level.title}</div>
                            <p>{level.count}</p>
                            {level.badge && <div class="badge">{level.badge}</div>}
                            <a href="javascript:void(0)"></a>
                        </div>
                    ))}
                </div>
                <div class="box" id="videos-box">
                    <div class="title" id="box-title">{videoLevels[0].title}</div>
                    <p class="subtitle" id="box-subtitle">{videoLevels[0].count} коротких видео</p>
                    <ul class="categories" style="display:none;">
                        <li><a class="active" href="javascript:void(0)">Все темы</a></li>
                    </ul>
                    <div class="videos-list" id="videos-list">
                        {videoLevels[0].videos.map((v) => (
                            <div class="item video-locked" data-id={v.id}>
                                <a class="thumb" href="/checkout">
                                    <img src={v.thumb} alt={v.cards} />
                                    <div class="lock-overlay"><img src="/img/premium-overlay.svg" alt="Заблокировано" /></div>
                                </a>
                                <div class="title">{v.title}</div>
                                <ul class="tags">
                                    <li>{v.cards}</li>
                                    <li>{v.duration}</li>
                                </ul>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </section>
    </main>

    <script src="../scripts/videos.ts"></script>
</PageLayout>
