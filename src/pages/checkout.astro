---
import PageLayout from '../layouts/PageLayout.astro';
import ProtectedPageGuard from '../components/auth/ProtectedPageGuard.astro';
import CheckoutButton from '../components/billing/CheckoutButton';
import SubscriptionStatus from '../components/billing/SubscriptionStatus';
import { BILLING_PLANS } from '../lib/billing/plans';

const rub = new Intl.NumberFormat('ru-RU');
---
<PageLayout title="Оформить подписку — MySimpleEnglish" description="Выберите подходящий тариф и получите доступ ко всем материалам платформы MySimpleEnglish.">
<Fragment slot="head">
    <ProtectedPageGuard loginPath="/" />
</Fragment>
<main>
    <section class="section-prices">
                    <div class="container">
                <h2 class="page-title text-center">Выберите подходящий тариф</h2>
                <p class="text-center white-text">Получите доступ ко всем материалам и развивайте английский в удобном темпе</p>
                <SubscriptionStatus client:load />
                <div class="infograph_items">
                    <div class="item">
                        <div class="img_block">
                            <img src="/img/Book_open_alt_light.svg" alt="">
                        </div>
                        <div class="info_block">
                            <p>Доступ ко всем материалам платформы</p>
                        </div>
                    </div>
                    <div class="item">
                        <div class="img_block">
                            <img src="/img/Calendar_add_light.svg" alt="">
                        </div>
                        <div class="info_block">
                            <p>Новые уроки добавляются регулярно</p>
                        </div>
                    </div>
                    <div class="item">
                        <div class="img_block">
                            <img src="/img/monitor-smartphone.svg" alt="">
                        </div>
                        <div class="info_block">
                            <p>Доступ с любых устройств</p>
                        </div>
                    </div>
                </div>
                <div class="price-list">
                                            <div class="item">
                            <div class="period">
                                                                    <div class="desc">
                                        Для знакомства                                    </div>
                                                                <div class="name">
                                    {BILLING_PLANS.month.title}                                </div>
                            </div>
                                                            <div class="text">
                                     {BILLING_PLANS.month.description}                                </div>
                                                        <div class="price">
                                <div class="current">{rub.format(BILLING_PLANS.month.amount)} ₽</div>
                                                                                            </div>
                            <div class="promo">
                                <input type="text" class="promo-input" name="promo-input" value="" placeholder="Введите код ..." data-subscription-id="1">                                <div class="hint-promo"></div>
                            </div>
                            <div class="action">
                                <CheckoutButton client:load planId="month" />
                            </div>
                            <div class="econom">Автопродление каждый месяц</div>
                        </div>
                                            <div class="item best_sell">
                            <div class="period">
                                                                    <div class="desc">
                                        Самый популярный                                    </div>
                                                                <div class="name">
                                    {BILLING_PLANS.quarter.title}                                </div>
                            </div>
                                                            <div class="text">
                                    {BILLING_PLANS.quarter.description}                                </div>
                                                        <div class="price">
                                <div class="current">{rub.format(BILLING_PLANS.quarter.amount)} ₽</div>
                                                                    <div class="old">3 000 ₽</div>
                                                                                                    <div class="econom">Экономия 127₽ в месяц (13%)</div>
                                                            </div>
                            <div class="promo">
                                <input type="text" class="promo-input" name="promo-input" value="" placeholder="Введите код ..." data-subscription-id="2">                                <div class="hint-promo"></div>
                            </div>
                            <div class="action">
                                <CheckoutButton client:load planId="quarter" />
                            </div>
                        </div>
                                            <div class="item benefit_sell">
                            <div class="period">
                                                                    <div class="desc">
                                        Самый выгодный                                    </div>
                                                                <div class="name">
                                    {BILLING_PLANS.year.title}                                </div>
                            </div>
                                                            <div class="text">
                                    {BILLING_PLANS.year.description}                                </div>
                                                        <div class="price">
                                <div class="current">{rub.format(BILLING_PLANS.year.amount)} ₽</div>
                                                                    <div class="old">12 000 ₽</div>
                                                                                                    <div class="econom">Экономия 241₽ в месяц (24%)</div>
                                                            </div>
                            <div class="promo">
                                <input type="text" class="promo-input" name="promo-input" value="" placeholder="Введите код ..." data-subscription-id="4">                                <div class="hint-promo"></div>
                            </div>
                            <div class="action">
                                <CheckoutButton client:load planId="year" />
                            </div>
                        </div>
                                    </div>
                <div class="infograph_items">
                    <div class="item">
                        <div class="img_block">
                            <img src="/img/Time_light.svg" alt="">
                        </div>
                        <div class="info_block">
                            <p>Учитесь в удобном темпе в любое время</p>
                        </div>
                    </div>
                    <div class="item">
                        <div class="img_block">
                            <img src="/img/Chield_check_light.svg" alt="">
                        </div>
                        <div class="info_block">
                            <p>Безопасные платежи с любых карт любых банков и из любой страны</p>
                        </div>
                    </div>
                    <div class="item">
                        <div class="img_block">
                            <img src="/img/Refresh_2_light.svg" alt="">
                        </div>
                        <div class="info_block">
                            <p>Отмена подписки в любой момент</p>
                        </div>
                    </div>
                </div>
                <p class="text_center">Для тарифа на 1 месяц включено ежемесячное автопродление. Тарифы на 3 и 12 месяцев оплачиваются один раз. Нажимая кнопку «Перейти к оплате», я соглашаюсь с условиями <a href="/page/publicnaa-oferta" target="_blank">публичной оферты.</a></p>
            </div>
            </section>
</main>
</PageLayout>
