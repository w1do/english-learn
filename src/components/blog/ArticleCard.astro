---
interface Props {
    title: string;
    excerpt?: string;
    date: string;
    url: string;
    image?: string;
}

const { title, excerpt, date, url, image = '/img/default-blog.png' } = Astro.props;
---

<article class="item">
    <div class="thumb">
        <a href={url}>
            <img src={image} alt={title} />
        </a>
    </div>
    <h2>
        <a href={url}>{title}</a>
    </h2>
    {excerpt && <p>{excerpt}</p>}
    <div class="date">{date}</div>
</article>
